---
const { event, date, location, image, description } = Astro.props;
---
<div class="grid grid-cols-[auto_1fr_auto] gap-4 sm:gap-6 w-full max-w-2xl mx-auto mb-4 items-start text-black">
  
  <div class="w-32 h-24 bg-gray-50 border-2 border-black flex items-center justify-center overflow-hidden flex-shrink-0">
     <img src={image} alt={event} class="w-full h-full object-cover" />
  </div>
  
  <div class="text-left flex flex-col justify-start">
    <span class="font-black text-xl">{event}</span>
    <!-- <span class="font-bold text-gray-700 mb-1">{role}</span> -->
    <span class="text-sm leading-relaxed">{description}</span>
  </div>
  
  <div class="sm:text-right flex flex-col flex-shrink-0 hidden sm:flex">
    <span class="font-bold uppercase tracking-wider text-sm">{date}</span>
    {location && <span class="text-gray-500 text-sm font-medium mt-1">{location}</span>}
  </div>

</div>