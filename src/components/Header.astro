</header>
<style>
@reference "../styles/global.css";

.header-parent {
  @apply mb-8 border-b border-black bg-white
}
.header-content {
  @apply w-full max-w-5xl mx-auto px-4 sm:px-6 py-4 sm:py-6 flex flex-col sm:flex-row justify-between items-center gap-3
}

.title-container {
  @apply font-bold text-xl tracking-tight
}
.title {
  @apply hover:text-blue-600 transition-colors
}

.nav-container {
  @apply flex flex-wrap justify-center gap-x-4 gap-y-2 text-sm font-medium text-gray-600
}
.nav-item {
  @apply hover:text-gray-900 transition-colors
}

</style>