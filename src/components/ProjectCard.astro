---
const { title, date, image, id } = Astro.props;
const modalId = `modal-${id}`;

const openModal = (id: string) => `
  const dialog = document.getElementById('${id}');
  dialog.showModal();
  document.documentElement.classList.add('modal-open');
`;

const closeModal = (id: string) => `
  const dialog = document.getElementById('${id}');
  dialog.close();
  document.documentElement.classList.remove('modal-open');
`;
---


<button onclick={openModal(modalId)} class="project-card">
  <div class="card-image-container">
    <img src={image} class="w-full h-full object-cover" />
  </div>
  <div class="card-content">
    <div class="card-date">{date}</div>
    <h3 class="card-title">{title}</h3>
  </div>
</button>

<dialog id={modalId} class="project-modal" onclose={`document.documentElement.classList.remove('modal-open')`}>
  <div class="modal-inner">
    <button onclick={closeModal(modalId)} class="modal-close-btn" aria-label="Close project">✕</button>
    
    <div class="modal-header">
      <div class="card-date text-gray-500">{date}</div>
      <h2 class="text-4xl font-black">{title}</h2>
    </div>
    
    <div class="prose prose-black max-w-none text-left">
      <slot /> 
    </div>
  </div>
</dialog>

<style>
@reference "../styles/global.css";

:global(html) {
  scrollbar-gutter: stable;
}

:global(html.modal-open) {
  overflow: hidden;
}

.project-card {
  @apply block w-full border-2 
  border-gray-400 rounded-2xl 
  overflow-hidden 
  hover:-translate-y-1 
  hover:shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] 
  transition-all bg-white mb-6 text-left cursor-pointer;
}

.card-image-container {
  @apply h-48 border-b-2 border-black bg-gray-50 flex items-center justify-center overflow-hidden;
}

.card-content {
  @apply p-2 sm:p-3 text-center;
  min-height: 6rem;
}


.card-date {
  @apply text-xs font-bold uppercase tracking-widest mb-2;
}

.card-title {
  @apply text-lg sm:text-xl font-black;
}

.project-modal {
  @apply backdrop:bg-black/60 backdrop:backdrop-blur-sm p-0 rounded-2xl border-2 border-black shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] w-[calc(100%-2rem)] max-w-3xl mx-auto top-1/2 -translate-y-1/2 m-0 bg-white outline-none;

  opacity: 0;
  transition: opacity 150ms ease;
}

.project-modal[open] {
  opacity: 1;
}

.project-modal::backdrop {
  opacity: 0;
  transition: opacity 150ms ease;
}

.project-modal[open]::backdrop {
  opacity: 1;
}

@starting-style {
  .project-modal[open] {
    opacity: 0;
  }

  .project-modal[open]::backdrop {
    opacity: 0;
  }
}

.modal-inner {
  @apply p-8 md:p-12 max-h-[85vh] overflow-y-auto;
}

.modal-close-btn {
  @apply absolute top-4 right-4 w-10 h-10 flex items-center justify-center border-2 border-black rounded-full hover:bg-gray-100 font-bold text-xl cursor-pointer bg-white;
}

.modal-header {
  @apply mb-8 border-b-2 border-black pb-6 text-center mt-4;
}
</style>