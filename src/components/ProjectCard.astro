---
const { title, date, image, id } = Astro.props;
const detailsId = `project-details-${id}`;
---

<button type="button" class="project-card" aria-expanded="false" aria-controls={detailsId}>
  <div class="card-image-container">
    <img src={image} class="w-full h-full object-cover" />
  </div>
  <div class="card-content">
    <div class="card-date">{date}</div>
    <h3 class="card-title">{title}</h3>
  </div>
</button>

<div id={detailsId} class="project-details-panel" hidden>
  <div class="project-details-frame">
    <div class="project-details-inner">
      <div class="project-details-header">
        <div class="card-date text-gray-500">{date}</div>
        <h2 class="text-3xl font-black">{title}</h2>
      </div>

      <div class="prose prose-black max-w-none text-left">
        <slot />
      </div>
    </div>
  </div>
</div>

<style>
@reference "../styles/global.css";

.project-card {
  @apply block w-full border-2
  border-gray-400 rounded-2xl
  overflow-hidden
  hover:-translate-y-1
  hover:shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]
  transition-all bg-white mb-6 text-left cursor-pointer;
}

.card-image-container {
  @apply h-48 border-b-2 border-black bg-gray-50 flex items-center justify-center overflow-hidden;
}

.card-content {
  @apply p-2 text-center;
  height: 7rem;
}

.card-date {
  @apply text-xs font-bold uppercase tracking-widest mb-2;
}

.card-title {
  @apply text-xl font-black;
}

.project-details-panel {
  @apply col-span-full w-full overflow-hidden mb-6;
  display: grid;
  grid-template-rows: 0fr;
  opacity: 0;
  transform: translateY(-0.5rem);
  transition: grid-template-rows 260ms ease, opacity 220ms ease, transform 260ms ease;
}

.project-details-panel.is-open {
  grid-template-rows: 1fr;
  opacity: 1;
  transform: translateY(0);
}

.project-details-panel[hidden] {
  display: none;
}

.project-details-frame {
  @apply min-h-0 overflow-hidden;
}

.project-details-inner {
  @apply bg-white rounded-2xl border-2 border-black shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] p-6 md:p-8;
}

.project-details-header {
  @apply mb-6 border-b-2 border-black pb-4 text-center;
}
</style>

<script>
  const closeProjectDetails = (panel: HTMLElement) => {
    const button = document.querySelector<HTMLElement>(`[aria-controls="${panel.id}"]`);

    panel.classList.remove('is-open');
    button?.setAttribute('aria-expanded', 'false');

    window.setTimeout(() => {
      if (!panel.classList.contains('is-open')) {
        panel.hidden = true;
      }
    }, 260);
  };

  const placePanelAfterCardRow = (card: HTMLElement, panel: HTMLElement) => {
    const grid = card.closest('.projects-grid');
    const cards = grid ? Array.from(grid.querySelectorAll<HTMLElement>('.project-card')) : [card];
    const cardIndex = cards.indexOf(card);
    const cardTop = card.offsetTop;
    let rowEnd: Element = card;

    for (const nextCard of cards.slice(cardIndex + 1)) {
      if (Math.abs(nextCard.offsetTop - cardTop) > 1) {
        break;
      }

      rowEnd = nextCard;
    }

    rowEnd.after(panel);
  };

  const openProjectDetails = (card: HTMLElement, panel: HTMLElement) => {
    document.querySelectorAll<HTMLElement>('.project-details-panel.is-open').forEach((openPanel) => {
      if (openPanel !== panel) {
        closeProjectDetails(openPanel);
      }
    });

    const button = document.querySelector<HTMLElement>(`[aria-controls="${panel.id}"]`);
    placePanelAfterCardRow(card, panel);
    panel.hidden = false;
    button?.setAttribute('aria-expanded', 'true');

    requestAnimationFrame(() => {
      panel.classList.add('is-open');
    });
  };

  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    const card = target.closest<HTMLElement>('.project-card');

    if (card) {
      const panelId = card.getAttribute('aria-controls');
      const panel = panelId ? document.getElementById(panelId) : null;

      if (panel) {
        panel.classList.contains('is-open') ? closeProjectDetails(panel) : openProjectDetails(card, panel);
      }

      return;
    }

    if (!target.closest('.project-details-panel')) {
      document.querySelectorAll<HTMLElement>('.project-details-panel.is-open').forEach(closeProjectDetails);
    }
  });
</script>
