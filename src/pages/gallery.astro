---
import Layout from '../layouts/Layout.astro';
import GalleryCard from '../components/GalleryCard.astro';

import { getCollection } from 'astro:content';

const gallery = (await getCollection('gallery')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<Layout title="Photo Gallery">
  <div class="page-header">
    <h1 class="page-title">Gallery</h1>
    <p class="page-subtitle">Cool pics</p>
  </div>

  <div class="gallery-grid">
    <!-- <div class="w-full max-w-3xl mx-auto flex flex-col"> -->
      {gallery.map((item) => (
        <GalleryCard
          title={item.data.title}
          date={item.data.date.toLocaleDateString('en-CA', {
            year: 'numeric',
            month: 'long',
          })}
          location={item.data.location}
          image={item.data.image}
          description={item.data.description}
        />
      ))}
    <!-- </div> -->
  </div>
</Layout>

<style>
  @reference "../styles/global.css";

  .page-header {
    @apply mb-12 text-center border-b-4 border-black pb-6 max-w-2xl mx-auto flex flex-col items-center;
  }

  .page-title {
    @apply text-4xl font-black mb-4 uppercase tracking-tight;
  }

  .page-subtitle {
    @apply text-gray-700 font-bold max-w-md;
  }

  .gallery-grid {
    @apply grid grid-cols-1 md:grid-cols-2 gap-6 w-full max-w-5xl mx-auto px-4;
  }
</style>