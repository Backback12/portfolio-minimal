    class="w-full max-w-5xl h-[700px] mx-auto p-0 overflow-hidden relative cursor-grab active:cursor-grabbing touch-none">
  </div> -->
  <div
    id="canvas-container"
    class="w-full max-w-[1200px] aspect-[4/3] mx-auto p-0 overflow-hidden relative cursor-grab active:cursor-grabbing touch-none">
  </div>
</Layout>

<script>
  import * as THREE from 'three';
  import { Agent } from '../utils/agent.js';

  let container, scene, camera, renderer;
  let agents = [];
  let obstacles = [];
  
  const MAP_SIZE = 24; 
  const bounds = { xMin: -MAP_SIZE/2, xMax: MAP_SIZE/2, zMin: -MAP_SIZE/2, zMax: MAP_SIZE/2 };

  const raycaster = new THREE.Raycaster();
  const mouse = new THREE.Vector2();
  let activeHoveredAgent = null;

  const target = new THREE.Vector3(0, 0, 0);

  let isDragging = false;
  let previousPointer = { x: 0, y: 0 };

  let azimuth = Math.atan2(20, 20);
  let elevation = Math.atan2(15, Math.sqrt(20 * 20 + 20 * 20));

  let targetAzimuth = azimuth;
  let targetElevation = elevation;

  let cameraDistance = Math.sqrt(20 * 20 + 15 * 15 + 20 * 20);
  let targetDistance = cameraDistance;

  const MIN_DISTANCE = 8;
  const MAX_DISTANCE = 45;

  const FRUSTUM_SIZE = 30;

  // Prevent viewing from underneath or completely flat with the floor
  const MIN_ELEVATION = THREE.MathUtils.degToRad(12);
  const MAX_ELEVATION = THREE.MathUtils.degToRad(60);

  let previousPinchDistance = null;

  let initialized = false;

  function init() {
    container = document.getElementById('canvas-container');
    if (!isWebGLAvailable()) {
      showWebGLError();
      return;
    }

    try {
      scene = new THREE.Scene();

      const width = container.clientWidth;
      const height = container.clientHeight;
      const aspect = width / height;
      const frustumSize = FRUSTUM_SIZE;

      camera = new THREE.OrthographicCamera(
        (frustumSize * aspect) / -2, (frustumSize * aspect) / 2,
        frustumSize / 2, frustumSize / -2,
        1, 1000
      );
      // camera.position.set(20, 15, 20);
      // camera.lookAt(0, 0, 0);
      updateCamera();

      renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
      renderer.setSize(width, height);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.5)); 
      renderer.shadowMap.enabled = true;
      renderer.shadowMap.type = THREE.PCFSoftShadowMap;
      container.appendChild(renderer.domElement);

      const ambientLight = new THREE.AmbientLight(0xffffff, 0.7);
      scene.add(ambientLight);

      const dirLight = new THREE.DirectionalLight(0xffffff, 1.2);
      dirLight.position.set(15, 30, 10);
      dirLight.castShadow = true;
      
      dirLight.shadow.camera.left = -MAP_SIZE;
      dirLight.shadow.camera.right = MAP_SIZE;
      dirLight.shadow.camera.top = MAP_SIZE;
      dirLight.shadow.camera.bottom = -MAP_SIZE;
      dirLight.shadow.mapSize.width = 1024;
      dirLight.shadow.mapSize.height = 1024;
      scene.add(dirLight);

      const floorGeo = new THREE.PlaneGeometry(MAP_SIZE, MAP_SIZE);
      const floorMat = new THREE.MeshLambertMaterial({ color: 0xffffff, transparent: true, opacity: 0.8 });
      const floor = new THREE.Mesh(floorGeo, floorMat);
      floor.rotation.x = -Math.PI / 2;
      floor.receiveShadow = true;
      scene.add(floor);

      spawnObstacles();
      spawnAgents();

      const resizeObserver = new ResizeObserver(() => onResize());
      resizeObserver.observe(container);

      container.addEventListener('pointerdown', onPointerDown);
      container.addEventListener('pointermove', onPointerMove);
      container.addEventListener('pointerup', onPointerUp);
      container.addEventListener('pointercancel', onPointerUp);
      container.addEventListener('wheel', onWheel, { passive: false });

      initialized = true;
    }
    catch (error) {
      console.error('Failed to initialize 3D renderer:', error);
      showWebGLError();
    }
  }

  function updateCamera() {
    camera.position.set(
      target.x + cameraDistance * Math.cos(elevation) * Math.sin(azimuth),
      target.y + cameraDistance * Math.sin(elevation),
      target.z + cameraDistance * Math.cos(elevation) * Math.cos(azimuth)
    );

    camera.lookAt(target);
  }

  const activePointers = new Map();

  function onPointerDown(event) {
    activePointers.set(event.pointerId, {
      x: event.clientX,
      y: event.clientY
    });

    if (activePointers.size === 1) {
      isDragging = true;
      previousPointer.x = event.clientX;
      previousPointer.y = event.clientY;
    }

    container.setPointerCapture(event.pointerId);
  }

  function onPointerMove(event) {
    if (!activePointers.has(event.pointerId)) return;

    activePointers.set(event.pointerId, {
      x: event.clientX,
      y: event.clientY
    });

    const pointers = [...activePointers.values()];

    // Pinch zoom
    if (pointers.length === 2) {
      const dx = pointers[0].x - pointers[1].x;
      const dy = pointers[0].y - pointers[1].y;
      const distance = Math.sqrt(dx * dx + dy * dy);

      if (previousPinchDistance !== null) {
        const delta = previousPinchDistance - distance;

        targetDistance += delta * 0.05;
        targetDistance = THREE.MathUtils.clamp(
          targetDistance,
          MIN_DISTANCE,
          MAX_DISTANCE
        );
      }

      previousPinchDistance = distance;
      return;
    }

    previousPinchDistance = null;

    if (!isDragging) return;

    const deltaX = event.clientX - previousPointer.x;
    const deltaY = event.clientY - previousPointer.y;

    previousPointer.x = event.clientX;
    previousPointer.y = event.clientY;

    targetAzimuth -= deltaX * 0.01;

    targetElevation += deltaY * 0.01;
    targetElevation = THREE.MathUtils.clamp(
      targetElevation,
      MIN_ELEVATION,
      MAX_ELEVATION
    );
  }

  function onPointerUp(event) {
    activePointers.delete(event.pointerId);

    isDragging = activePointers.size === 1;
    previousPinchDistance = null;

    if (container.hasPointerCapture(event.pointerId)) {
      container.releasePointerCapture(event.pointerId);
    }
  }

  function onWheel(event) {
  event.preventDefault();

  targetDistance += event.deltaY * 0.02;

  targetDistance = THREE.MathUtils.clamp(
    targetDistance,
    MIN_DISTANCE,
    MAX_DISTANCE
  );
}

  function spawnObstacles() {
    const obstacleConfigs = [
      // { x: -4, z: -3, radius: 1.2, height: 3, color: 0x94a3b8 },
      // { x: 5, z: 6, radius: 1.5, height: 2, color: 0x94a3b8 }
    ];

    obstacleConfigs.forEach((cfg) => {
      const geo = new THREE.CylinderGeometry(cfg.radius, cfg.radius, cfg.height, 16);
      const mat = new THREE.MeshLambertMaterial({ color: cfg.color });
      const mesh = new THREE.Mesh(geo, mat);
      mesh.position.set(cfg.x, cfg.height / 2, cfg.z);
      mesh.castShadow = true;
      mesh.receiveShadow = true;
      scene.add(mesh);

      obstacles.push({ mesh: mesh, position: mesh.position, radius: cfg.radius });
    });
  }

  function spawnAgents() {
    const configs = [
      { name: 'Maze Bot', type: 'car', modelUrl: '/models/maze_bot.glb', rotation: -Math.PI / 2, scale: 0.5, hitboxScale: 1.0 },
      { name: 'Prairie Pioneer', type: 'car', modelUrl: '/models/prairie_pioneer.glb', rotation: -Math.PI / 2, scale: 2, hitboxScale: 1.8 },
      { name: 'Project Perry', type: 'car', modelUrl: '/models/project_perry.glb', rotation: -Math.PI / 2, scale: 2, hitboxScale: 1.8 },
      { name: 'Sumo Bot', type: 'car', modelUrl: '/models/sumo_bot.glb', rotation: -Math.PI / 2, scale: 0.5, hitboxScale: 1.0, speedScale: 3 },
      { name: 'Micromouse', type: 'car', modelUrl: '/models/micromouse.glb', rotation: -Math.PI / 2, scale: 0.3, hitboxScale: 1.0, speedScale: 1.0 },
      { name: 'Prairie Panther', type: 'car', modelUrl: '/models/prairie_panther.glb', rotation: -Math.PI / 2, scale: 1.8, hitboxScale: 1.8 },
    ];

    configs.forEach((cfg, i) => {
      const randomStartPos = new THREE.Vector3(
        THREE.MathUtils.randFloat(bounds.xMin + 3, bounds.xMax - 3),
        0, 
        THREE.MathUtils.randFloat(bounds.zMin + 3, bounds.zMax - 3)
      );

      const agent = new Agent(i, cfg.name, cfg.type, scene, bounds, randomStartPos, cfg.modelUrl, cfg.scale, cfg.rotation, cfg.hitboxScale, cfg.speedScale);
      agents.push(agent);
    });
  }

  function onMouseMove(event) {
    const rect = container.getBoundingClientRect();
    mouse.x = ((event.clientX - rect.left) / rect.width) * 2 - 1;
    mouse.y = -((event.clientY - rect.top) / rect.height) * 2 + 1;
  }

  function handleInteractions() {
    raycaster.setFromCamera(mouse, camera);
    
    const agentMeshes = agents.map(a => a.mesh);
    const intersects = raycaster.intersectObjects(agentMeshes, true);

    if (intersects.length > 0) {
      let rootMesh = intersects[0].object;
      while (rootMesh.parent && rootMesh.parent !== scene) {
        rootMesh = rootMesh.parent;
      }

      const matchedAgent = agents.find(a => a.mesh === rootMesh);
      
      if (activeHoveredAgent && activeHoveredAgent !== matchedAgent) {
        activeHoveredAgent.setHoverState(false);
      }

      if (matchedAgent) {
        activeHoveredAgent = matchedAgent;
        matchedAgent.setHoverState(true);
        return;
      }
    }

    if (activeHoveredAgent) {
      activeHoveredAgent.setHoverState(false);
      activeHoveredAgent = null;
    }
  }

  function onResize() {
    if (!container) return;
    const width = container.clientWidth;
    const height = container.clientHeight;
    const aspect = width / height;
    const frustumSize = FRUSTUM_SIZE;

    camera.left = (frustumSize * aspect) / -2;
    camera.right = (frustumSize * aspect) / 2;
    camera.top = frustumSize / 2;
    camera.bottom = frustumSize / -2;
    
    camera.updateProjectionMatrix();
    renderer.setSize(width, height);
  }

  function animate(time) {
    requestAnimationFrame(animate);
    const timestampSeconds = time * 0.001;

    agents.forEach(agent => {
      // Pass the agents array alongside obstacles
      if(agent.update) agent.update(obstacles, agents, timestampSeconds);
    });

    handleInteractions();
    azimuth = THREE.MathUtils.lerp(azimuth, targetAzimuth, 0.12);
    elevation = THREE.MathUtils.lerp(
      elevation,
      targetElevation,
      0.12
    );

    cameraDistance = THREE.MathUtils.lerp(
      cameraDistance,
      targetDistance,
      0.12
    );

    updateCamera();
    renderer.render(scene, camera);
  }

  function isWebGLAvailable() {
    try {
      const canvas = document.createElement('canvas');

      return !!(
        window.WebGLRenderingContext &&
        (
          canvas.getContext('webgl2') ||
          canvas.getContext('webgl')
        )
      );
    } catch {
      return false;
    }
  }

  function showWebGLError() {
    if (!container) return;

    container.innerHTML = `
      <div class="w-full h-full flex items-center justify-center p-6">
        <div class="max-w-md text-center">
          <h2 class="text-xl font-bold mb-2">
            3D Graphics Unavailable
          </h2>

          <p class="text-gray-600">
            This device or browser does not support the graphics features
            required to run this simulation.
          </p>
        </div>
      </div>
    `;
  }

  init();
  if (initialized){
    requestAnimationFrame(animate);
  }
</script>