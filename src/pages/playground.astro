---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Playground" fullWidth={true}>
  <div
    id="robot-container"
    class="w-full max-w-[1200px] aspect-[4/3] mx-auto p-0 overflow-hidden relative cursor-grab active:cursor-grabbing touch-none">
  </div>

    
  <section class="w-full max-w-[800px] mx-auto mt-12">
    <h3 class="section-title">Connect Four</h3>
    <div
      id="connect-four-status"
      class="min-h-8 mt-3 text-center text-lg font-semibold select-none"
      aria-live="polite">
      Loading Connect Four...
    </div>
    <div
      id="connect-four-score"
      class="text-center text-sm text-gray-500 mt-2 select-none"
    >
      Public: <span id="connect-public-score">0</span>
      <span class="mx-2">|</span>
      Owner: <span id="connect-owner-score">0</span>
    </div>
    <div
      id="connect-four-container"
      class="w-full aspect-[1/1] overflow-hidden relative cursor-grab active:cursor-grabbing touch-none rounded-lg">
    </div>
  </section>
  <div>
    3D models are licensed under <a href="https://creativecommons.org/licenses/by-nc/4.0/">CC BY-NC 4.0</a><img src="https://mirrors.creativecommons.org/presskit/icons/cc.svg" alt="" style="max-width: 1em;max-height:1em;margin-left: .2em;"><img src="https://mirrors.creativecommons.org/presskit/icons/by.svg" alt="" style="max-width: 1em;max-height:1em;margin-left: .2em;"><img src="https://mirrors.creativecommons.org/presskit/icons/nc.svg" alt="" style="max-width: 1em;max-height:1em;margin-left: .2em;">
  </div>
</Layout>

<script>
  import '../scripts/playground-robots.js';
  import '../scripts/playground-connect4.js';
</script>
