---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import EventCard from '../components/EventCard.astro';
import { getCollection, render } from 'astro:content';

const allProjects = await getCollection('projects');

const featuredProjectIds = ['micromouse', 'balance-bot', 'sumo-bot'];

const featuredProjects = allProjects.filter(project => 
  featuredProjectIds.includes(project.id)
);
---

<Layout title="Connor's Stuff" class="body">
  <section class="hero-section">
    <h1 class="hero-title">Connor Pagtakhan</h1>
    <h2 class="hero-subtitle">Computer Engineering</h2>
    <p class="hero-description">
      Here is a website with stuff I've worked on and stuff I find cool
    </p>
  </section>

  <section class="section-wrapper">
    <h3 class="section-title">Some Projects</h3>
    <div class="projects-grid">
      {featuredProjects.map(async (project) => {
        const { Content } = await render(project);
        return (
          <ProjectCard 
            title={project.data.title} 
            date={project.data.date} 
            image={project.data.image}
            id={`home-${project.id}`}
          >
            <Content />
          </ProjectCard>
        );
      })}
    </div>
  </section>

  <section class="awards-wrapper">
    <h3 class="section-title">Awards & Events</h3>
    <EventCard
      event="CIRC 2026"
      date="August 2026"
      location="Drumheller, AB"
      image="/images/no-image.png"
      description="UMRT"
    />
    <EventCard
      event="RoboWars 2026"
      date="May 2026"
      location="Montreal, QB"
      image="/images/no-image.png"
      description="UMIEEE/UMRT at Concordia University"
    />
    <EventCard
