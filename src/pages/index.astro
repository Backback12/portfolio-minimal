---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection, render } from 'astro:content';

const allProjects = await getCollection('projects');

const featuredProjectIds = ['micromouse', 'balance-bot'];

const featuredProjects = allProjects.filter(project => 
  featuredProjectIds.includes(project.id)
);
---

<Layout title="Connor's Stuff">
  <section class="hero-section">
    <h1 class="hero-title">Connor Pagtakhan</h1>
    <h2 class="hero-subtitle">Computer Engineering</h2>
    <p class="hero-description">
      Here is a website with stuff I've worked on and stuff I find cool
    </p>
  </section>

  <section class="section-wrapper">
    <h3 class="section-title">Selected Projects</h3>
    <div class="projects-grid">
      {featuredProjects.map(async (project) => {
        const { Content } = await render(project);
        return (
          <ProjectCard 
            title={project.data.title} 
            date={project.data.date} 
            image={project.data.image}
            slug={`home-${project.id}`}
          >
            <Content />
          </ProjectCard>
        );
      })}
    </div>
  </section>

  <section class="awards-wrapper">
    <h3 class="section-title">Awards & Events</h3>
    
    <div class="award-item">
      <div class="award-thumbnail">
        </div>
      
      <div class="award-info">
        <h4 class="award-title">CEC 2024</h4>
        <p class="award-description"></p>
      </div>
      
      <div class="award-date-container">
        <span class="award-date">Spring 2024</span>
      </div>
    </div>

    <div class="award-item">
      <div class="award-thumbnail">
        </div>
      <div class="award-info">
        <h4 class="award-title">WEC 2024</h4>
        <p class="award-description"></p>
      </div>
      <div class="award-date-container">
        <span class="award-date">Winter 2024</span>
      </div>
    </div>
  </section>
</Layout>

<style>
  @reference "../styles/global.css";

  .hero-section {
    @apply mb-16 flex flex-col items-center;
  }

  .hero-title {
    @apply text-3xl font-black mb-2 uppercase tracking-tight;
  }

  .hero-subtitle {
    @apply text-lg font-bold text-gray-500 mb-6 uppercase tracking-widest border-b-2 border-black pb-2;
  }

  .hero-description {
    @apply text-black font-medium leading-relaxed mb-4 max-w-2xl text-center;
  }

  /* Section Classes */
  .section-wrapper {
    @apply mb-16 w-full max-w-4xl mx-auto;
  }

  .section-title {
    @apply text-2xl font-black mb-8 border-b-4 border-black pb-2 text-center uppercase w-full;
  }

  /* Projects Classes */
  .projects-grid {
    @apply grid grid-cols-1 md:grid-cols-2 gap-8;
  }

  .awards-wrapper {
    @apply flex flex-col items-center w-full max-w-3xl mx-auto;
  }

  .award-item {
    @apply grid 
    grid-cols-1 sm:grid-cols-[auto_1fr_auto] 
    gap-4 sm:gap-6 
    w-full items-start text-black 
    /* border-2 */
    /* border-gray-500  */
    rounded-2xl p-2 bg-white mb-6;
  }

  .award-thumbnail {
    @apply w-16 h-16 bg-gray-50 border-2 border-black flex items-center justify-center overflow-hidden flex-shrink-0;
  }

  .award-info {
    @apply text-left flex flex-col justify-start;
  }

  .award-title {
    @apply font-black text-xl mb-1;
  }

  .award-description {
    @apply text-sm text-gray-700 leading-relaxed;
  }

  .award-date-container {
    @apply sm:text-right flex flex-col flex-shrink-0 mt-2 sm:mt-0;
  }

  .award-date {
    @apply font-bold uppercase tracking-wider text-sm;
  }
</style>